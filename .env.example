# General Configuration
PROJECT_NAME=AutoDS
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-this-in-production-super-secret-key-32bytes
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database (pgvector enabled)
POSTGRES_USER=autods_user
POSTGRES_PASSWORD=autods_password
POSTGRES_DB=autods_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://autods_user:autods_password@postgres:5432/autods_db

# Redis Task Queue & Event Broker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here

# File Storage Configuration
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
