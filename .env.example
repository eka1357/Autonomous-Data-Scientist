# ==============================================================================
# AutoDS Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# General & Application Runtime
# ------------------------------------------------------------------------------
# Application display title
PROJECT_NAME=AutoDS
# Runtime environment mode: development | staging | production
ENVIRONMENT=development
# Logging detail level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# JWT secret key for signing user auth tokens (MUST be at least 32 characters in production)
SECRET_KEY=change-this-in-production-super-secret-key-32bytes

# ------------------------------------------------------------------------------
# Network & CORS Configuration
# ------------------------------------------------------------------------------
# Primary production frontend URL (used by Render to dynamically configure CORS)
FRONTEND_URL=https://autods-frontend.vercel.app
# Allowed CORS origins (JSON array or comma-separated URLs)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://autods-frontend.vercel.app"]

# ------------------------------------------------------------------------------
# PostgreSQL Database (pgvector Extension Enabled)
# ------------------------------------------------------------------------------
# Fallback database connection credentials (used if DATABASE_URL is not set)
POSTGRES_USER=autods_user
POSTGRES_PASSWORD=autods_password
POSTGRES_DB=autods_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Primary database connection string (auto-generated by Render Blueprint or manually provided)
DATABASE_URL=postgresql+asyncpg://autods_user:autods_password@postgres:5432/autods_db

# ------------------------------------------------------------------------------
# Redis Cache & Celery Task Queue
# ------------------------------------------------------------------------------
# Fallback Redis connection parameters
REDIS_HOST=redis
REDIS_PORT=6379
# Primary Redis connection URL (auto-generated by Render Blueprint or manually provided)
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# AI & OpenAI LLM Integration
# ------------------------------------------------------------------------------
# OpenAI / OpenRouter API Key for Executive AI Summaries & RAG Assistant
OPENAI_API_KEY=your-openai-api-key-here

# ------------------------------------------------------------------------------
# File Storage & Artifact Persistence
# ------------------------------------------------------------------------------
# Storage engine type: local | s3
STORAGE_BACKEND=local
# Local disk directory for dataset uploads, generated charts, and HTML reports
STORAGE_LOCAL_DIR=./storage

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Set in Vercel Dashboard)
# ------------------------------------------------------------------------------
# Public API base endpoint accessed by the Next.js client browser
NEXT_PUBLIC_API_URL=https://autods-backend.onrender.com/api/v1
